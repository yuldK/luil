{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-common",
            "hidden": true,
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_SYSTEM_VERSION": "10.0.22621.0",
                "LUIL_BUILD_TESTS": "OFF",
                "LUIL_ENABLE_MSVC_ANALYZE": "OFF"
            }
        },
        {
            "name": "vs2022",
            "displayName": "Visual Studio 2022 x64",
            "inherits": "windows-common",
            "generator": "Visual Studio 17 2022"
        },
        {
            "name": "vs2026",
            "displayName": "Visual Studio 2026 x64",
            "inherits": "windows-common",
            "generator": "Visual Studio 18 2026"
        },
        {
            "name": "vs2022-tests",
            "displayName": "Visual Studio 2022 x64 with tests",
            "inherits": "vs2022",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_BUILD_TESTS": "ON",
                "LUIL_BUILD_TOOLING": "ON",
                "LUIL_ENABLE_SVG": "ON",
                "LUIL_ENABLE_TEXT_SHAPING": "ON",
                "LUIL_ENABLE_TEXT_SHAPING_FALLBACK": "ON",
                "LUIL_ENABLE_AVIF": "ON",
                "LUIL_ENABLE_LOTTIE": "ON"
            }
        },
        {
            "name": "vs2026-tests",
            "displayName": "Visual Studio 2026 x64 with tests",
            "inherits": "vs2026",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_BUILD_TESTS": "ON",
                "LUIL_BUILD_TOOLING": "ON",
                "LUIL_ENABLE_SVG": "ON",
                "LUIL_ENABLE_TEXT_SHAPING": "ON",
                "LUIL_ENABLE_TEXT_SHAPING_FALLBACK": "ON",
                "LUIL_ENABLE_AVIF": "ON",
                "LUIL_ENABLE_LOTTIE": "ON"
            }
        },
        {
            "name": "vs2022-examples",
            "displayName": "Visual Studio 2022 x64 with examples",
            "inherits": "vs2022",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_BUILD_EXAMPLES": "ON",
                "LUIL_ENABLE_SVG": "ON",
                "LUIL_ENABLE_TEXT_SHAPING": "ON",
                "LUIL_ENABLE_TEXT_SHAPING_FALLBACK": "ON",
                "LUIL_ENABLE_AVIF": "ON",
                "LUIL_ENABLE_LOTTIE": "ON"
            }
        },
        {
            "name": "vs2026-examples",
            "displayName": "Visual Studio 2026 x64 with examples",
            "inherits": "vs2026",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_BUILD_EXAMPLES": "ON",
                "LUIL_ENABLE_SVG": "ON",
                "LUIL_ENABLE_TEXT_SHAPING": "ON",
                "LUIL_ENABLE_TEXT_SHAPING_FALLBACK": "ON",
                "LUIL_ENABLE_AVIF": "ON",
                "LUIL_ENABLE_LOTTIE": "ON"
            }
        },
        {
            "name": "vs2022-analysis",
            "displayName": "Visual Studio 2022 x64 with MSVC analysis",
            "inherits": "vs2022",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_ENABLE_MSVC_ANALYZE": "ON"
            }
        },
        {
            "name": "vs2026-analysis",
            "displayName": "Visual Studio 2026 x64 with MSVC analysis",
            "inherits": "vs2026",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_ENABLE_MSVC_ANALYZE": "ON"
            }
        },
        {
            "name": "android-arm64-core",
            "displayName": "Android arm64 core library and device tests",
            "description": "Needs ANDROID_NDK_HOME (NDK r27d), Ninja, and a JDK (Android Studio JBR or JAVA_HOME) with SDK build-tools for the JVM test entry. Tests run on the adb device.",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-26",
                "ANDROID_STL": "c++_static",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "LUIL_BUILD_TESTS": "ON",
                "LUIL_ENABLE_SVG": "ON",
                "LUIL_ENABLE_TEXT_SHAPING": "ON",
                "LUIL_ENABLE_TEXT_SHAPING_FALLBACK": "ON",
                "LUIL_ENABLE_AVIF": "ON",
                "LUIL_ENABLE_LOTTIE": "ON"
            }
        },
        {
            "name": "android-arm64",
            "displayName": "Android arm64 library, examples and device tests",
            "description": "Needs ANDROID_NDK_HOME (NDK r27d) and Ninja. Examples are packaged by examples/android (Gradle).",
            "inherits": "android-arm64-core",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_BUILD_EXAMPLES": "ON",
                "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON"
            }
        },
        {
            "name": "macos-arm64-core",
            "displayName": "macOS arm64 core library and tests",
            "description": "Needs Xcode and Ninja. Builds luil_core, the AppKit host library and the core tests.",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "LUIL_BUILD_TESTS": "ON",
                "LUIL_ENABLE_SVG": "ON",
                "LUIL_ENABLE_TEXT_SHAPING": "ON",
                "LUIL_ENABLE_TEXT_SHAPING_FALLBACK": "ON",
                "LUIL_ENABLE_AVIF": "ON",
                "LUIL_ENABLE_LOTTIE": "ON"
            }
        },
        {
            "name": "macos-arm64",
            "displayName": "macOS arm64 library, examples and tests",
            "description": "Needs Xcode and Ninja. Adds the hello and demo examples on the AppKit host.",
            "inherits": "macos-arm64-core",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_BUILD_EXAMPLES": "ON"
            }
        },
        {
            "name": "ios-common",
            "hidden": true,
            "description": "Needs Xcode and Ninja. Builds the UIKit host library and the iOS examples (no test run: the binaries run on the device or the simulator).",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "LUIL_BUILD_EXAMPLES": "ON",
                "LUIL_ENABLE_SVG": "ON",
                "LUIL_ENABLE_TEXT_SHAPING": "ON",
                "LUIL_ENABLE_TEXT_SHAPING_FALLBACK": "ON",
                "LUIL_ENABLE_AVIF": "ON",
                "LUIL_ENABLE_LOTTIE": "ON"
            }
        },
        {
            "name": "ios-arm64-simulator",
            "displayName": "iOS Simulator arm64 library and examples",
            "description": "Apple Silicon simulator (iphonesimulator SDK). Uses the ios-arm64-simulator Skia package.",
            "inherits": "ios-common",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_OSX_SYSROOT": "iphonesimulator"
            }
        },
        {
            "name": "ios-arm64",
            "displayName": "iOS arm64 (iPhone, iPad) library and examples",
            "description": "Devices (iphoneos SDK). Uses the ios-arm64 Skia package. Installing on a device needs a signing identity and a provisioning profile (LUIL_IOS_CODE_SIGN_IDENTITY, LUIL_IOS_PROVISIONING_PROFILE).",
            "inherits": "ios-common",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_OSX_SYSROOT": "iphoneos"
            }
        }
    ],
    "buildPresets": [
