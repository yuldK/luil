{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-common",
            "hidden": true,
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_SYSTEM_VERSION": "10.0.22621.0",
                "LUIL_BUILD_TESTS": "OFF",
                "LUIL_ENABLE_MSVC_ANALYZE": "OFF"
            }
        },
        {
            "name": "vs2022",
            "displayName": "Visual Studio 2022 x64",
            "inherits": "windows-common",
            "generator": "Visual Studio 17 2022"
        },
        {
            "name": "vs2026",
            "displayName": "Visual Studio 2026 x64",
            "inherits": "windows-common",
            "generator": "Visual Studio 18 2026"
        },
        {
            "name": "vs2022-tests",
            "displayName": "Visual Studio 2022 x64 with tests",
            "inherits": "vs2022",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_BUILD_TESTS": "ON",
                "LUIL_BUILD_TOOLING": "ON"
            }
        },
        {
            "name": "vs2026-tests",
            "displayName": "Visual Studio 2026 x64 with tests",
            "inherits": "vs2026",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_BUILD_TESTS": "ON",
                "LUIL_BUILD_TOOLING": "ON"
            }
        },
        {
            "name": "vs2022-examples",
            "displayName": "Visual Studio 2022 x64 with examples",
            "inherits": "vs2022",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_BUILD_EXAMPLES": "ON"
            }
        },
        {
            "name": "vs2026-examples",
            "displayName": "Visual Studio 2026 x64 with examples",
            "inherits": "vs2026",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_BUILD_EXAMPLES": "ON"
            }
        },
        {
            "name": "vs2022-analysis",
            "displayName": "Visual Studio 2022 x64 with MSVC analysis",
            "inherits": "vs2022",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_ENABLE_MSVC_ANALYZE": "ON"
            }
        },
        {
            "name": "vs2026-analysis",
            "displayName": "Visual Studio 2026 x64 with MSVC analysis",
            "inherits": "vs2026",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "LUIL_ENABLE_MSVC_ANALYZE": "ON"
            }
        },
        {
            "name": "android-arm64-core",
            "displayName": "Android arm64 core library and device tests",
            "description": "Needs ANDROID_NDK_HOME (NDK r27d) and Ninja. Tests run on the adb device.",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-26",
                "ANDROID_STL": "c++_static",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "LUIL_BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vs2022-debug",
            "configurePreset": "vs2022",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-release",
            "configurePreset": "vs2022",
            "configuration": "Release"
        },
        {
            "name": "vs2022-analysis",
            "configurePreset": "vs2022-analysis",
            "configuration": "Debug"
        },
        {
            "name": "vs2026-debug",
            "configurePreset": "vs2026",
            "configuration": "Debug"
        },
        {
            "name": "vs2026-release",
            "configurePreset": "vs2026",
            "configuration": "Release"
        },
        {
            "name": "vs2026-analysis",
            "configurePreset": "vs2026-analysis",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-examples-debug",
            "configurePreset": "vs2022-examples",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-examples-release",
            "configurePreset": "vs2022-examples",
            "configuration": "Release"
        },
        {
            "name": "vs2026-examples-debug",
            "configurePreset": "vs2026-examples",
            "configuration": "Debug"
        },
        {
            "name": "vs2026-examples-release",
            "configurePreset": "vs2026-examples",
            "configuration": "Release"
        },
        {
            "name": "vs2022-tests-debug",
            "configurePreset": "vs2022-tests",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-tests-release",
            "configurePreset": "vs2022-tests",
            "configuration": "Release"
        },
        {
            "name": "vs2026-tests-debug",
            "configurePreset": "vs2026-tests",
            "configuration": "Debug"
        },
        {
            "name": "vs2026-tests-release",
            "configurePreset": "vs2026-tests",
            "configuration": "Release"
        },
        {
            "name": "android-arm64-core-debug",
            "configurePreset": "android-arm64-core",
            "configuration": "Debug"
        },
        {
            "name": "android-arm64-core-release",
            "configurePreset": "android-arm64-core",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "vs2022-tests-debug",
            "configurePreset": "vs2022-tests",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "vs2022-tests-release",
            "configurePreset": "vs2022-tests",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "vs2026-tests-debug",
            "configurePreset": "vs2026-tests",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "vs2026-tests-release",
            "configurePreset": "vs2026-tests",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "android-arm64-core-debug",
            "configurePreset": "android-arm64-core",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "android-arm64-core-release",
            "configurePreset": "android-arm64-core",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ]
}
