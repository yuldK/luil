* text=auto

*.cmake text eol=crlf
*.cpp text eol=crlf
*.h text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.ps1 text eol=crlf
*.rc text eol=crlf
*.xml text eol=crlf
CMakeLists.txt text eol=crlf
.clang-format text eol=crlf
.clang-tidy text eol=crlf
.gitignore text eol=crlf

# Gradle 예제 프로젝트다. gradlew는 Unix 셸이 읽으므로 LF여야 하고, wrapper jar는 공식
# 배포본의 checksum을 보존한다.
gradlew text eol=lf
*.bat text eol=crlf
*.kts text eol=crlf
*.properties text eol=crlf
*.jar binary

# 공식 배포본의 checksum을 보존해야 하는 vendored 자산이다.
/assets/codicons/** -text
*.ttf binary
*.ico binary
*.png binary
*.jpg binary
*.gif binary
*.webp binary

# submodule로 가져오는 제3자 소스는 정규화하지 않는다.
/third_party/catch2/** -text
/third_party/nlohmann_json/** -text
