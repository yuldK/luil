<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS 예제 번들의 Info.plist다. examples/macos.cmake의 luil_add_macos_bundle이 대상마다 채운다. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>ko</string>
    <key>CFBundleDisplayName</key>
    <string>@luil_bundle_name@</string>
    <key>CFBundleExecutable</key>
    <string>@luil_bundle_executable@</string>
    <key>CFBundleIdentifier</key>
    <string>@luil_bundle_identifier@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>@luil_bundle_name@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@PROJECT_VERSION@</string>
    <key>LSMinimumSystemVersion</key>
    <string>@LUIL_MINIMUM_MACOS_VERSION@</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
