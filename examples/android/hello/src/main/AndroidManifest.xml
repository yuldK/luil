<?xml version="1.0" encoding="utf-8"?>
<!--
    luil hello의 Android 매니페스트다.
    Activity는 GameActivity 그대로다. 앱 쪽 Java 코드가 없고, 네이티브 라이브러리(luil_hello)의
    android_main이 앱이다 (docs/android-port-plan.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="luil hello"
        android:theme="@style/Theme.Luil">
        <!--
            회전·크기·밀도·어두운 모드는 Activity를 다시 만들지 않고 네이티브 쪽이 받는다
            (APP_CMD_CONFIG_CHANGED). 다시 만들면 네이티브 상태가 처음부터 다시 선다.
        -->
        <activity
            android:name="com.google.androidgamesdk.GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|layoutDirection"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="luil_hello" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
