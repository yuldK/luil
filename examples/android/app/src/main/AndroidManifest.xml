<?xml version="1.0" encoding="utf-8"?>
<!--
    luil 예제의 Android 매니페스트다. 예제(flavor)마다 이름과 네이티브 라이브러리만 다르다
    (build.gradle.kts의 manifestPlaceholders).
    Activity는 GameActivity 그대로다. 앱 쪽 Java 코드가 없고, 네이티브 라이브러리(luil_hello 등)의
    android_main이 앱이다 (docs/android-port-plan.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        뒤로 가기는 키 이벤트로 받는다. Android 16부터 targetSdk 36 이상은 이것이 없으면 뒤로 가기 키가
        오지 않는다 (예측 뒤로 가기). 앱이 뒤로 가기를 받는 길은 `ui_frame::back`이다.
    -->
    <application
        android:enableOnBackInvokedCallback="false"
        android:label="${label}"
        android:theme="@style/Theme.Luil">
        <!--
            회전·크기·밀도·어두운 모드는 Activity를 다시 만들지 않고 네이티브 쪽이 받는다
            (APP_CMD_CONFIG_CHANGED). 다시 만들면 네이티브 상태가 처음부터 다시 선다.
        -->
        <activity
            android:name="com.google.androidgamesdk.GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|layoutDirection"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="${libraryName}" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
