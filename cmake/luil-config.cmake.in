@PACKAGE_INIT@

# 손으로 빌드한 Skia의 위치는 소비자 환경이 이 변수들로 지정하는 것이 계약이다.
# 설치 시점의 경로는 같은 머신에서 쓸 때의 편의 기본값일 뿐이다 —
# LUIL_SKIA_ROOT만 바꾸면 빌드 디렉터리는 패키지의 기본 위치로 따라온다.
# 검사 논리는 빌드 트리와 동일한 cmake/dependencies/skia.cmake 하나다 —
# 잘못 빌드한 Skia는 링크 오류가 아니라 원인이 드러나는 메시지로 잡히고,
# 지금 빌드하는 구성에 필요한 flavor(Debug·Release)만 검사된다.
if(NOT DEFINED LUIL_SKIA_ROOT)
    set(LUIL_SKIA_ROOT "@LUIL_SKIA_ROOT@")
    set(_luil_build_debug_default "@LUIL_SKIA_BUILD_DEBUG@")
    set(_luil_build_release_default "@LUIL_SKIA_BUILD_RELEASE@")
else()
    set(_luil_build_debug_default "${LUIL_SKIA_ROOT}/out/skia-ui-debug")
    set(_luil_build_release_default "${LUIL_SKIA_ROOT}/out/skia-ui-release")
endif()
if(NOT DEFINED LUIL_SKIA_BUILD_DEBUG)
    set(LUIL_SKIA_BUILD_DEBUG "${_luil_build_debug_default}")
endif()
if(NOT DEFINED LUIL_SKIA_BUILD_RELEASE)
    set(LUIL_SKIA_BUILD_RELEASE "${_luil_build_release_default}")
endif()
unset(_luil_build_debug_default)
unset(_luil_build_release_default)
set(LUIL_SKIA_TARGET "@LUIL_SKIA_TARGET@")
set(LUIL_SKIA_COMPONENTS "@LUIL_SKIA_COMPONENTS@")
set(LUIL_SKIA_SYSTEM_LIBRARIES "@LUIL_SKIA_SYSTEM_LIBRARIES@")
set(LUIL_SKIA_RUST_PNG_SYSTEM_LIBRARIES "@LUIL_SKIA_RUST_PNG_SYSTEM_LIBRARIES@")
set(LUIL_SKIA_REQUIRED_ARGUMENTS "@LUIL_SKIA_REQUIRED_ARGUMENTS@")
set(LUIL_SKIA_REQUIRED_TOOLCHAIN "@LUIL_SKIA_REQUIRED_TOOLCHAIN@")
# 설치한 라이브러리가 켠 Skia 기능이다 (CMakeLists.txt의 LUIL_ENABLE_SVG 등).
# 링크 목록(LUIL_SKIA_COMPONENTS)에는 이미 그 아카이브가 들어 있고, 이 목록은
# 텍스트 정의와 고지 생성기가 읽는다. 소비자는 LUIL_ENABLE_*로 무엇이 켜졌는지 본다.
set(LUIL_SKIA_FEATURES "@LUIL_SKIA_FEATURES@")
set(LUIL_ENABLE_SVG @LUIL_ENABLE_SVG@)
set(LUIL_ENABLE_TEXT_SHAPING @LUIL_ENABLE_TEXT_SHAPING@)
set(LUIL_ENABLE_TEXT_SHAPING_FALLBACK @LUIL_ENABLE_TEXT_SHAPING_FALLBACK@)
set(LUIL_ENABLE_AVIF @LUIL_ENABLE_AVIF@)
set(LUIL_ENABLE_LOTTIE @LUIL_ENABLE_LOTTIE@)
# 설치한 패키지에 선택 라이브러리 차트가 들어 있는가다 (docs/chart-library-design.md). 소비자는 구성 요소 `chart`로 묻는다.
set(LUIL_BUILD_CHART @LUIL_BUILD_CHART@)

include("${CMAKE_CURRENT_LIST_DIR}/skia.cmake")
luil_find_skia()

# WebView2 SDK도 같은 규칙이다 — 검사 논리가 빌드 트리와 같은 파일 하나이고,
# 설치 시점의 경로는 같은 머신 편의 기본값이다.
#  - flavor 축이 없다. 로더 아카이브가 CRT 중립이라 구성마다 갈리지 않는다
#    (cmake/dependencies/webview2.cmake).
#  - 웹뷰를 끄고 설치한 라이브러리에는 로더가 링크되지 않았으므로 SDK를 찾지도
#    잇지도 않는다. 고지 생성기도 같은 값을 본다.
set(LUIL_ENABLE_WEBVIEW @LUIL_ENABLE_WEBVIEW@)
# 설치한 라이브러리에 Direct3D 렌더러가 들어 있는가다. 소비자가 읽기만 한다 —
# Skia 패키지와 링크 목록은 어느 쪽이든 같다.
set(LUIL_ENABLE_DIRECT3D @LUIL_ENABLE_DIRECT3D@)
if(NOT DEFINED LUIL_WEBVIEW2_ROOT)
    set(LUIL_WEBVIEW2_ROOT "@LUIL_WEBVIEW2_ROOT@")
endif()
if(LUIL_ENABLE_WEBVIEW)
    include("${CMAKE_CURRENT_LIST_DIR}/webview2.cmake")
    luil_find_webview2()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/luil-targets.cmake")
# 차트의 내보내기 묶음은 따로다. `luil::luil_core`를 참조하므로 위의 파일 뒤에 읽는다.
#  - `luil_chart_FOUND`는 아래 `check_required_components`가 본다. 그 매크로는 찾지 못했다는 사실만 세우므로, 차트를 끄고 설치한
#    패키지에서 `COMPONENTS chart`로 물었을 때 원인은 여기서 적어 둔다.
#  - 값까지 보는 까닭은 같은 prefix에 끈 구성을 덮어 설치하면 옛 파일이 남아서다.
if(LUIL_BUILD_CHART AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/luil-chart-targets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/luil-chart-targets.cmake")
    set(luil_chart_FOUND TRUE)
else()
    set(luil_chart_FOUND FALSE)
    if(luil_FIND_REQUIRED_chart)
        set(luil_NOT_FOUND_MESSAGE "This luil package was installed without the chart library. Install it from a build configured with LUIL_BUILD_CHART=ON.")
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/generate_notices.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/string_table.cmake")

# 설치본에 지금 빌드하는 구성의 luil 산출물이 있는지 확인한다.
# 없는 구성은 조용한 CRT 불일치 링크 오류가 아니라 여기서 원인과 함께 잡힌다.
get_target_property(_luil_installed_configurations luil::luil
    IMPORTED_CONFIGURATIONS)
foreach(_luil_configuration IN ITEMS Debug Release)
    string(TOUPPER "${_luil_configuration}" _luil_flavor)
    if(LUIL_SKIA_NEEDS_${_luil_flavor}
        AND NOT "${_luil_flavor}" IN_LIST _luil_installed_configurations)
        message(FATAL_ERROR
            "This luil package was not installed for the "
            "${_luil_configuration} configuration "
            "(installed: ${_luil_installed_configurations}).\n"
            "Install it from the luil build tree:\n"
            "  cmake --install <luil build directory> "
            "--config ${_luil_configuration}")
    endif()
endforeach()
unset(_luil_installed_configurations)
unset(_luil_configuration)
unset(_luil_flavor)

# 빌드 트리에서는 $<BUILD_INTERFACE>로 잇던 것들을 설치본에서 다시 잇는다.
# Skia는 core와 플랫폼 조립이 함께 쓰므로 둘 다에 잇는다.
set_property(TARGET luil::luil_core APPEND PROPERTY INTERFACE_LINK_LIBRARIES luil_skia)
set_property(TARGET luil::luil APPEND PROPERTY INTERFACE_LINK_LIBRARIES luil_skia)
if(LUIL_ENABLE_WEBVIEW)
    set_property(TARGET luil::luil APPEND PROPERTY INTERFACE_LINK_LIBRARIES luil_webview2)
endif()

check_required_components(luil)
