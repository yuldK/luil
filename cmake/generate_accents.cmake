# 키 컬러 정의(assets/accents.json)를 C++ 값 표로 바꾼다.
# 런타임 JSON 파싱을 두지 않으려고 빌드 시점에 내장하며, 형식 오류는 여기서 빌드를 세운다.
#  - 잘못된 색이 조용히 화면에 나가는 것보다 낫다.
if(NOT DEFINED INPUT_FILE OR NOT DEFINED OUTPUT_FILE)
    message(FATAL_ERROR "INPUT_FILE and OUTPUT_FILE are required.")
endif()

file(READ "${INPUT_FILE}" accents_json)
if(NOT DEFINED DEFAULT_ACCENT_ID)
    set(DEFAULT_ACCENT_ID "mint")
endif()
string(JSON catalog_type ERROR_VARIABLE type_error TYPE "${accents_json}")
if(type_error OR NOT catalog_type STREQUAL "ARRAY")
    message(FATAL_ERROR "Accent catalog must be a JSON array: ${INPUT_FILE}")
endif()
string(JSON accent_count ERROR_VARIABLE json_error LENGTH "${accents_json}")
if(json_error)
    message(FATAL_ERROR "Accent catalog is not valid JSON: ${INPUT_FILE}\n${json_error}")
endif()
if(accent_count EQUAL 0)
    message(FATAL_ERROR "Accent catalog is empty: ${INPUT_FILE}")
endif()

# `#rrggbb`를 불투명 ARGB 상수로 바꾼다.
# 다른 표기는 받지 않는다.
function(luil_accent_color output_variable accent_index role_path color_text)
    if(NOT color_text MATCHES "^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$")
        message(FATAL_ERROR "Accent ${accent_index} has an invalid ${role_path} color: ${color_text} (expected #rrggbb)")
    endif()
    string(SUBSTRING "${color_text}" 1 6 color_digits)
    string(TOUPPER "${color_digits}" color_digits)
    set(${output_variable} "0xFF${color_digits}u" PARENT_SCOPE)
endfunction()

# 한 테마의 4역할을 accent, accentHover, accentSoft, accentEmphasisFg 순으로 읽는다.
function(luil_accent_role_set output_variable accent_index entry_json theme_key)
    set(role_values)
    foreach(role_key accent accentHover accentSoft accentEmphasisFg)
        string(JSON role_text ERROR_VARIABLE role_error GET "${entry_json}" "${theme_key}" "${role_key}")
        if(role_error)
            message(FATAL_ERROR "Accent ${accent_index} is missing ${theme_key}.${role_key}: ${role_error}")
        endif()
        luil_accent_color(role_color ${accent_index} "${theme_key}.${role_key}" "${role_text}")
        list(APPEND role_values "${role_color}")
    endforeach()
    list(JOIN role_values ", " joined_roles)
    set(${output_variable} "${joined_roles}" PARENT_SCOPE)
endfunction()

# 이름을 C++ 문자열로 안전하게 내보낸다.
function(luil_accent_escape output_variable text)
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\\\"" text "${text}")
    string(REPLACE "\n" "\\n" text "${text}")
    string(REPLACE "\r" "\\r" text "${text}")
    string(REPLACE "\t" "\\t" text "${text}")
    set(${output_variable} "${text}" PARENT_SCOPE)
endfunction()

# 이름은 글 하나거나 언어 맵이다 (docs/i18n-adoption-design.md 결정 4).
#  - 맵에는 `ko`가 있어야 하고 그 글이 `accent_definition::label`이다. 글 하나는 모든 언어에서 그 글이다.
#  - `ko` 밖의 언어는 생성 헤더의 표 칸 글로 돌려주고 그 수는 `<names_variable>_count`다. 같은 원본이 같은 헤더가 되도록 태그 차례로 둔다.
#  - 태그 꼴은 문자열 표와 같다 (generate_strings.cmake의 `luil_strings_tag_pattern`).
function(luil_accent_label label_variable names_variable accent_id entry_json)
    string(JSON label_type ERROR_VARIABLE label_error TYPE "${entry_json}" "label")
    if(label_error)
        message(FATAL_ERROR "Accent ${accent_id} has no label: ${label_error}")
    endif()
    if(label_type STREQUAL "STRING")
        string(JSON label_text GET "${entry_json}" "label")
        if(label_text STREQUAL "")
            message(FATAL_ERROR "Accent ${accent_id} has an empty label")
        endif()
        set(${label_variable} "${label_text}" PARENT_SCOPE)
        set(${names_variable} "" PARENT_SCOPE)
        return()
    endif()
    if(NOT label_type STREQUAL "OBJECT")
        message(FATAL_ERROR "Accent ${accent_id} label must be a string or a language map: ${label_type}")
    endif()

    string(JSON language_count LENGTH "${entry_json}" "label")
    set(languages)
    set(folded_languages)
    if(language_count GREATER 0)
        math(EXPR last_language_index "${language_count} - 1")
        foreach(language_index RANGE 0 ${last_language_index})
            string(JSON language MEMBER "${entry_json}" "label" ${language_index})
            if(NOT language MATCHES "^[a-z][a-z][a-z]?(-[A-Za-z0-9]+)*$")
                message(FATAL_ERROR "Accent ${accent_id} label has an invalid language tag: ${language}")
            endif()
            string(TOLOWER "${language}" folded_language)
            if(folded_language IN_LIST folded_languages)
                message(FATAL_ERROR "Accent ${accent_id} label has two tags that differ only in case: ${language}")
            endif()
            list(APPEND folded_languages "${folded_language}")
            list(APPEND languages "${language}")
        endforeach()
    endif()
    if(NOT "ko" IN_LIST languages)
        message(FATAL_ERROR "Accent ${accent_id} label map must have ko")
    endif()
    list(SORT languages)

    set(names)
    foreach(language IN LISTS languages)
        string(JSON text_type TYPE "${entry_json}" "label" "${language}")
        if(NOT text_type STREQUAL "STRING")
            message(FATAL_ERROR "Accent ${accent_id} label for ${language} must be a string: ${text_type}")
        endif()
        string(JSON language_text GET "${entry_json}" "label" "${language}")
        if(language_text STREQUAL "")
            message(FATAL_ERROR "Accent ${accent_id} label for ${language} is empty")
        endif()
        if(language STREQUAL "ko")
            set(${label_variable} "${language_text}" PARENT_SCOPE)
        else()
            luil_accent_escape(escaped_text "${language_text}")
            string(APPEND names "        { u8\"${language}\", u8\"${escaped_text}\" },\n")
        endif()
    endforeach()
    list(LENGTH languages language_total)
    math(EXPR name_total "${language_total} - 1")
    set(${names_variable} "${names}" PARENT_SCOPE)
    set(${names_variable}_count "${name_total}" PARENT_SCOPE)
endfunction()

set(output_text "#pragma once\n\n#include <cstdint>\n\n")
string(APPEND output_text "// accent 카탈로그 JSON에서 생성된 파일이다. 직접 고치지 않는다.\n")
string(APPEND output_text "namespace luil::generated {\n")
string(APPEND output_text "    // 키 컬러 이름의 언어 하나다. `ko`는 `accent_entry::label`이고 여기 없다.\n")
string(APPEND output_text "    struct accent_name\n    {\n")
string(APPEND output_text "        const char8_t* language;\n")
string(APPEND output_text "        const char8_t* label;\n")
string(APPEND output_text "    };\n\n")
string(APPEND output_text "    struct accent_entry\n    {\n")
string(APPEND output_text "        const char8_t* id;\n")
string(APPEND output_text "        const char8_t* label;\n")
string(APPEND output_text "        // 설정의 색 동그라미다. 테마와 무관한 대표색이다.\n")
string(APPEND output_text "        std::uint32_t swatch;\n")
string(APPEND output_text "        // accent, accent_hover, accent_soft, accent_emphasis_fg 순이다.\n")
string(APPEND output_text "        std::uint32_t dark[4];\n")
string(APPEND output_text "        std::uint32_t light[4];\n")
string(APPEND output_text "        // `accent_names`에서 이 항목의 이름이 시작하는 칸과 그 수다.\n")
string(APPEND output_text "        std::uint32_t first_name;\n")
string(APPEND output_text "        std::uint32_t name_count;\n")
string(APPEND output_text "    };\n\n")

set(entries_text "")
set(names_text "")
set(name_position 0)
math(EXPR last_accent_index "${accent_count} - 1")
set(seen_identifiers)
foreach(accent_index RANGE 0 ${last_accent_index})
    string(JSON entry_json GET "${accents_json}" ${accent_index})

    string(JSON accent_id ERROR_VARIABLE id_error GET "${entry_json}" "id")
    if(id_error OR accent_id STREQUAL "")
        message(FATAL_ERROR "Accent ${accent_index} has no id: ${id_error}")
    endif()
    if(NOT accent_id MATCHES "^[a-z0-9-]+$")
        message(FATAL_ERROR "Accent id must be lower case ASCII with hyphens: ${accent_id}")
    endif()
    # 실행 시점 항목(OS accent)의 예약 id다.
    # 정적 표에 두면 한 id에 임자가 둘이 된다.
    if(accent_id STREQUAL "system")
        message(FATAL_ERROR "The accent id is reserved for the runtime entry: system")
    endif()
    if(accent_id IN_LIST seen_identifiers)
        message(FATAL_ERROR "Duplicate accent id: ${accent_id}")
    endif()
    list(APPEND seen_identifiers "${accent_id}")

    set(accent_names_count 0)
    luil_accent_label(accent_label accent_names "${accent_id}" "${entry_json}")

    string(JSON swatch_text ERROR_VARIABLE swatch_error GET "${entry_json}" "swatch")
    if(swatch_error)
        message(FATAL_ERROR "Accent ${accent_id} has no swatch: ${swatch_error}")
    endif()
    luil_accent_color(swatch_color ${accent_index} "swatch" "${swatch_text}")

    luil_accent_role_set(dark_roles ${accent_index} "${entry_json}" "dark")
    luil_accent_role_set(light_roles ${accent_index} "${entry_json}" "light")

    luil_accent_escape(accent_label "${accent_label}")
    string(APPEND entries_text
        "        { u8\"${accent_id}\", u8\"${accent_label}\", ${swatch_color}, { ${dark_roles} }, { ${light_roles} }, ${name_position}u, ${accent_names_count}u },\n")
    string(APPEND names_text "${accent_names}")
    math(EXPR name_position "${name_position} + ${accent_names_count}")
endforeach()

# 앱 설정이 모르는 id를 담고 있을 때 물러설 기본 색이다.
# 없으면 오류 처리한다.
if(NOT DEFAULT_ACCENT_ID IN_LIST seen_identifiers)
    message(FATAL_ERROR "The accent catalog must contain the default id: ${DEFAULT_ACCENT_ID}")
endif()

# 끝의 빈 칸은 언어 맵이 없는 카탈로그를 위한 자리다. C++은 빈 배열을 받지 않는다. `name_count`가 이 칸을 읽지 않게 한다.
string(APPEND output_text "    inline constexpr accent_name accent_names[] {\n")
string(APPEND output_text "${names_text}")
string(APPEND output_text "        { u8\"\", u8\"\" },\n")
string(APPEND output_text "    };\n\n")
string(APPEND output_text "    inline constexpr accent_entry accents[] {\n")
string(APPEND output_text "${entries_text}")
string(APPEND output_text "    };\n}\n")
get_filename_component(output_directory "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
file(WRITE "${OUTPUT_FILE}" "${output_text}")
