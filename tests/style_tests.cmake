cmake_minimum_required(VERSION 4.2)

# 스타일 생성 script의 계약이다 — 받아야 할 파일은 받고, 어긋난 파일은 막는다.
# 생성물이 `ui_style`의 지정 초기화라, 여기서 새는 것은 컴파일 오류나 조용한 기본값이 된다.
#  - 받음·막음 사례는 실행 중 파서와 함께 도는 공유 사례 표(style_cases.json)에 있다. 사례는 거기 한 번만 더한다.
set(generator "${SOURCE_DIR}/cmake/generate_style.cmake")
include("${SOURCE_DIR}/cmake/style_keys.cmake")
file(MAKE_DIRECTORY "${BINARY_DIR}/style-test")
set(input "${BINARY_DIR}/style-test/style.json")
set(output "${BINARY_DIR}/style-test/ui_style.h")
set(keys_output "${BINARY_DIR}/style-test/ui_style_keys.h")

# 생성기를 돌려 받음 여부를 본다. 막을 때의 오류 글은 `generation_error`에 남긴다.
function(luil_expect_generation input_text should_succeed what)
    file(WRITE "${input}" "${input_text}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT_FILE=${input}" "-DOUTPUT_FILE=${output}"
        -P "${generator}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error_text)
    if(should_succeed AND NOT result EQUAL 0)
        message(FATAL_ERROR "Generation failed but should succeed: ${what}\n${error_text}")
    endif()
    if(NOT should_succeed AND result EQUAL 0)
        message(FATAL_ERROR "Generation succeeded but should fail: ${what}")
    endif()
    set(generation_error "${error_text}" PARENT_SCOPE)
endfunction()

# CMake는 긴 오류 글을 여러 줄로 접어 들여 쓴다. 공백을 하나로 모아 견준다.
function(luil_collapse_spaces output_variable text)
    string(REGEX REPLACE "[ \t\r\n]+" " " collapsed "${text}")
    set(${output_variable} "${collapsed}" PARENT_SCOPE)
endfunction()

# 내장 파일은 그대로 지나가고 생성물에 지정 초기화가 선다.
file(READ "${SOURCE_DIR}/assets/style.json" style)
luil_expect_generation("${style}" TRUE "the built-in style")
file(READ "${output}" header)
foreach(needle
    "inline constexpr ui_style default_style"
    ".window_background = 0xFF1E1E1Eu"
    ".secondary_foreground = 0xBFFFFFFFu"
    ".close_button_hover_background = 0xFFC42B1Cu"
    ".raised_background = 0xFF38383Cu"
    ".thumb_background = 0x29FFFFFFu"
    ".syntax_keyword = 0xFF6CB2F2u"
    ".syntax_string = 0xFFDBA184u"
    ".syntax_comment = 0xFF8DBB78u"
    ".syntax_number = 0xFFB5CEA8u"
    ".syntax_type = 0xFF4EC9B0u"
    ".syntax_function = 0xFFDCDCAAu"
    ".syntax_keyword = 0xFF0000FFu"
    ".syntax_function = 0xFF6E5320u"
    ".body_font_size = 12.0f"
    ".soft_button = 0.25f"
    ".selected_choice = font_weight::semibold"
    ".line_break = single_line_break::space"
    ".wrap_policy = line_break_policy::hangul_words")
    string(FIND "${header}" "${needle}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "The generated header lacks: ${needle}")
    endif()
endforeach()

# 사례 표의 JSON 키를 생성물의 필드로 옮긴다. 키는 데이터 파일의 표에서 찾는다.
#  - `enum_type`은 이름 칸일 때만 선다.
function(luil_style_field_of key field_variable enum_variable)
    set(found_field "")
    set(found_enum "")
    foreach(pair IN LISTS neutral_fields neutral_optional_fields caption_fields tone_fields metric_fields)
        string(REPLACE "|" ";" parts "${pair}")
        list(GET parts 0 pair_key)
        list(GET parts 1 pair_field)
        if(pair_key STREQUAL key AND found_field STREQUAL "")
            set(found_field "${pair_field}")
        endif()
    endforeach()
    set(enum_specs ${font_weight_fields})
    foreach(section IN LISTS component_sections)
        string(REPLACE "|" ";" parts "${section}")
        list(GET parts 2 fields_variable)
        list(APPEND enum_specs ${${fields_variable}})
    endforeach()
    foreach(spec IN LISTS enum_specs)
        string(REPLACE "|" ";" parts "${spec}")
        list(GET parts 0 spec_key)
        if(spec_key STREQUAL key AND found_field STREQUAL "")
            list(GET parts 1 found_field)
            list(GET parts 2 found_enum)
        endif()
    endforeach()
    if(found_field STREQUAL "")
        message(FATAL_ERROR "The case table names a key that is not in the key table: ${key}")
    endif()
    set(${field_variable} "${found_field}" PARENT_SCOPE)
    set(${enum_variable} "${found_enum}" PARENT_SCOPE)
endfunction()

# 사례 하나의 JSON 경로(`path` 배열)를 CMake 리스트로 읽는다.
function(luil_case_path output_variable object_json)
    string(JSON count LENGTH "${object_json}" path)
    math(EXPR last "${count} - 1")
    set(path "")
    foreach(index RANGE 0 ${last})
        string(JSON part GET "${object_json}" path ${index})
        list(APPEND path "${part}")
    endforeach()
    set(${output_variable} "${path}" PARENT_SCOPE)
endfunction()

# 공유 사례 표를 돈다. 받을 사례는 적힌 값이 생성물에 있는지, 막을 사례는 적힌 오류 글이 생성기의 오류인지 본다.
file(READ "${SOURCE_DIR}/tests/style_cases.json" cases_json)
string(JSON case_count LENGTH "${cases_json}" cases)
math(EXPR last_case "${case_count} - 1")
foreach(case_index RANGE 0 ${last_case})
    string(JSON case_json GET "${cases_json}" cases ${case_index})
    string(JSON name GET "${case_json}" name)
    string(JSON accept GET "${case_json}" accept)

    string(JSON case_text ERROR_VARIABLE no_text GET "${case_json}" text)
    if(no_text)
        set(case_text "${style}")
    endif()
    string(JSON edit_count ERROR_VARIABLE no_edits LENGTH "${case_json}" edits)
    if(NOT no_edits AND edit_count GREATER 0)
        math(EXPR last_edit "${edit_count} - 1")
        foreach(edit_index RANGE 0 ${last_edit})
            string(JSON edit_json GET "${case_json}" edits ${edit_index})
            string(JSON op GET "${edit_json}" op)
            luil_case_path(edit_path "${edit_json}")
            if(op STREQUAL "set")
                string(JSON value GET "${edit_json}" value)
                string(JSON case_text SET "${case_text}" ${edit_path} "${value}")
            elseif(op STREQUAL "remove")
                string(JSON case_text REMOVE "${case_text}" ${edit_path})
            else()
                message(FATAL_ERROR "Unknown edit in case '${name}': ${op}")
            endif()
        endforeach()
    endif()

    luil_expect_generation("${case_text}" ${accept} "${name}")
    if(NOT accept)
        string(JSON expected_message GET "${case_json}" error message)
        luil_collapse_spaces(expected_message "${expected_message}")
        luil_collapse_spaces(actual_message "${generation_error}")
        string(FIND "${actual_message}" "${expected_message}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Case '${name}' stopped with another error.\nExpected: ${expected_message}\nActual: ${generation_error}")
        endif()
        continue()
    endif()

    file(READ "${output}" header)
    string(JSON expect_count ERROR_VARIABLE no_expect LENGTH "${case_json}" expect)
    if(no_expect OR expect_count EQUAL 0)
        continue()
    endif()
    math(EXPR last_expect "${expect_count} - 1")
    foreach(expect_index RANGE 0 ${last_expect})
        string(JSON expect_json GET "${case_json}" expect ${expect_index})
        luil_case_path(expect_path "${expect_json}")
        list(GET expect_path -1 key)
        luil_style_field_of("${key}" field enum_type)
        string(JSON is_default ERROR_VARIABLE no_default GET "${expect_json}" default)
        string(JSON color ERROR_VARIABLE no_color GET "${expect_json}" color)
        string(JSON number ERROR_VARIABLE no_number GET "${expect_json}" number)
        string(JSON enum_name ERROR_VARIABLE no_name GET "${expect_json}" name)
        # 빠진 칸은 struct의 기본값이다 — 생성물에 그 필드가 적히지 않는다.
        if(NOT no_default)
            string(FIND "${header}" ".${field} =" position)
            if(NOT position EQUAL -1)
                message(FATAL_ERROR "Case '${name}' still wrote ${field}")
            endif()
            continue()
        endif()
        if(NOT no_color)
            string(REGEX MATCH "^#([0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])?$" matched "${color}")
            set(alpha "${CMAKE_MATCH_2}")
            if(alpha STREQUAL "")
                set(alpha "FF")
            endif()
            string(TOUPPER "0x${alpha}${CMAKE_MATCH_1}u" literal)
            string(REPLACE "0X" "0x" literal "${literal}")
            string(REGEX REPLACE "U$" "u" literal "${literal}")
        elseif(NOT no_number)
            if(number MATCHES "[.e]")
                set(literal "${number}f")
            else()
                set(literal "${number}.0f")
            endif()
        elseif(NOT no_name)
            string(REGEX REPLACE "([A-Z])" "_\\1" snake "${enum_name}")
            string(TOLOWER "${snake}" snake)
            set(literal "${enum_type}::${snake}")
        else()
            message(FATAL_ERROR "Case '${name}' has an expectation without a value")
        endif()
        string(FIND "${header}" ".${field} = ${literal}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Case '${name}' lacks in the header: .${field} = ${literal}")
        endif()
    endforeach()
endforeach()

# 키 표 헤더에는 데이터 파일의 행이 모두 선다. 대신할 필드도 함께다.
execute_process(COMMAND "${CMAKE_COMMAND}" "-DKEYS_OUTPUT_FILE=${keys_output}" -P "${generator}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error_text)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "The key table generation failed:\n${error_text}")
endif()
file(READ "${keys_output}" keys_header)
set(key_needles "")
foreach(pair IN LISTS neutral_fields)
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 key)
    list(GET parts 1 field)
    list(APPEND key_needles "{ \"${key}\", &neutral_color_palette::${field}, nullptr }")
endforeach()
foreach(pair IN LISTS caption_fields)
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 key)
    list(GET parts 1 field)
    list(APPEND key_needles "{ \"${key}\", &caption_section::${field} }")
endforeach()
foreach(pair IN LISTS tone_fields)
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 key)
    list(GET parts 1 field)
    list(APPEND key_needles "{ \"${key}\", &accent_tones::${field} }")
endforeach()
foreach(pair IN LISTS metric_fields)
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 key)
    list(GET parts 1 field)
    list(APPEND key_needles "{ \"${key}\", &ui_metrics::${field} }")
endforeach()
foreach(spec IN LISTS font_weight_fields)
    string(REPLACE "|" ";" parts "${spec}")
    list(GET parts 0 key)
    list(GET parts 1 field)
    list(APPEND key_needles "make_enum_row(\"${key}\", &font_weights_section::${field}, font_weight_names)")
endforeach()
list(APPEND key_needles
    "{ \"syntaxFunction\", &neutral_color_palette::syntax_function, &neutral_color_palette::primary_foreground }"
    "{ \"raisedBackground\", &neutral_color_palette::raised_background, &neutral_color_palette::notice_background }"
    "{ \"selectedOrHovered\", tab_close_visibility::selected_or_hovered }"
    "make_component(\"tabBar\", &ui_style::tab_bar"
    "make_enum_row(\"lineBreak\", &text_section::line_break, single_line_break_names)"
    "make_enum_row(\"wrapPolicy\", &text_section::wrap_policy, line_break_policy_names)")
foreach(needle IN LISTS key_needles)
    string(FIND "${keys_header}" "${needle}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "The key table header lacks: ${needle}")
    endif()
endforeach()

# 대신할 키가 꼭 있는 키가 아니면 생성이 멈춘다. 선택 키를 대신하면 그 값이 빌 수 있다.
file(READ "${SOURCE_DIR}/cmake/style_keys.cmake" keys_text)
string(REPLACE "\"syntaxFunction|syntax_function|primaryForeground\"" "\"syntaxFunction|syntax_function|raisedBackground\"" broken_keys "${keys_text}")
if(broken_keys STREQUAL keys_text)
    message(FATAL_ERROR "The key table no longer has the syntaxFunction row this test edits")
endif()
set(broken_keys_file "${BINARY_DIR}/style-test/broken_style_keys.cmake")
file(WRITE "${broken_keys_file}" "${broken_keys}")
foreach(mode_argument "-DKEYS_OUTPUT_FILE=${keys_output}" "-DINPUT_FILE=${SOURCE_DIR}/assets/style.json;-DOUTPUT_FILE=${output}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DKEYS_FILE=${broken_keys_file}" ${mode_argument} -P "${generator}"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error_text)
    luil_collapse_spaces(error_text "${error_text}")
    if(result EQUAL 0)
        message(FATAL_ERROR "A fallback to an optional key was accepted (${mode_argument})")
    endif()
    string(FIND "${error_text}" "The fallback of syntaxFunction must be a required neutral key: raisedBackground" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "A fallback to an optional key stopped with another error: ${error_text}")
    endif()
endforeach()
